# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Configuration
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://db_user:db_password@cluster0.abcde.mongodb.net/resume-generator?retryWrites=true&w=majority

# Client Configuration (CORS)
CLIENT_URL=http://localhost:5173
